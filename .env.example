ASPNETCORE_ENVIRONMENT=Production
Security__RequireAuthentication=false

Jwt__Issuer=TravelAgencyApi
Jwt__Audience=TravelAgencyFrontend
Jwt__Secret=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

TravelProviders__FlightProvider=Duffel
TravelProviders__LocationProvider=Local
Duffel__BaseUrl=https://api.duffel.com
Duffel__AccessToken=CHANGE_ME_DUFFEL_TEST_TOKEN
Duffel__Version=v2
Duffel__MaxResponseBytes=5242880
Duffel__TimeoutSeconds=45
Duffel__SupplierTimeoutMilliseconds=15000
Duffel__MaxConnections=1
Duffel__MaxOffersToRead=10
Duffel__ReturnEmptyOnTimeout=true
Duffel__UseReturnOffers=false

# Legacy/optional Amadeus settings (only needed when selecting Amadeus provider)
Amadeus__BaseUrl=https://test.api.amadeus.com
Amadeus__ClientId=CHANGE_ME
Amadeus__ClientSecret=CHANGE_ME

ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=travel_agency_dev;Username=postgres;Password=postgres

Cors__AllowAnyOrigin=true
Cors__AllowedOrigins__0=http://localhost:5173
Swagger__Enabled=true
Database__ApplyMigrationsOnStartup=true
TravelSearchDefaults__DefaultOrigin=GRU

Database__FailStartupOnMissingTables=true

AirportDataSync__Enabled=true
AirportDataSync__SyncOnStartup=true
AirportDataSync__StartupDelaySeconds=5
AirportDataSync__RefreshIntervalHours=24
AirportDataSync__PeriodicCheckHours=6
AirportDataSync__RequestTimeoutSeconds=90
AirportDataSync__ImportBatchSize=500
AirportDataSync__MinimumAirportCount=5000
AirportDataSync__ImportClosedAirports=false
AirportDataSync__AirportsCsvUrl=https://davidmegginson.github.io/ourairports-data/airports.csv
AirportDataSync__CountriesCsvUrl=https://davidmegginson.github.io/ourairports-data/countries.csv
