{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=travel_agency_dev;Username=postgres;Password=postgres"
  },
  "Security": {
    "RequireAuthentication": false
  },
  "Jwt": {
    "Issuer": "TravelAgencyApi",
    "Audience": "TravelAgencyFrontend",
    "Secret": "USE_USER_SECRETS_FOR_REAL_SECRET",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Amadeus": {
    "BaseUrl": "https://test.api.amadeus.com",
    "ClientId": "USE_USER_SECRETS",
    "ClientSecret": "USE_USER_SECRETS"
  },
  "Cors": {
    "AllowAnyOrigin": true,
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "TravelSearchDefaults": {
    "DefaultOrigin": "GRU"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "TravelProviders": {
    "FlightProvider": "Duffel",
    "LocationProvider": "Mock"
  },
  "Duffel": {
    "BaseUrl": "https://api.duffel.com",
    "AccessToken": "USE_USER_SECRETS",
    "Version": "v2"
  }
}
